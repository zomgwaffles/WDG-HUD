<?xml version="1.0" encoding="utf-8"?>
<!-- G5A50.1: explicitly deny both cloud and device-to-device transfer.
     On some manufacturers, allowBackup=false alone does not disable D2D. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
